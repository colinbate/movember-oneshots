---
const title = "Enterprising Warlocks";
const description =
    "A Movember 2026 charity tabletop one-shot using the Keeper's Call RPG.";
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="generator" content={Astro.generator} />
        <meta name="description" content={description} />
        <meta name="theme-color" content="#dbe75b" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="preconnect" href="https://fonts.bunny.net" />
        <link
            href="https://fonts.bunny.net/css?family=atkinson-hyperlegible:400,400i,700|bowlby-one-sc:400"
            rel="stylesheet"
        />
        <title>{title} — Movember 2026</title>
        <style is:global>
            :root {
                --ink: #171912;
                --paper: #fff8dd;
                --paper-deep: #f4e9bd;
                --slime: #dbe75b;
                --slime-dark: #526229;
                --orange: #ed6f31;
                --rust: #9e3e24;
                --blue: #4b8492;
                --line: 3px solid var(--ink);
            }

            * {
                box-sizing: border-box;
            }

            html {
                scroll-behavior: smooth;
                background: var(--slime);
            }

            body {
                min-width: 18rem;
                min-height: 100svh;
                margin: 0;
                padding: 1rem 0;
                color: var(--ink);
                background-color: var(--slime);
                background-image:
                    radial-gradient(
                        circle at 10% 18%,
                        rgba(255, 255, 255, 0.38) 0 2px,
                        transparent 3px
                    ),
                    radial-gradient(
                        circle at 88% 70%,
                        rgba(23, 25, 18, 0.1) 0 3px,
                        transparent 4px
                    );
                background-size:
                    34px 34px,
                    51px 51px;
                font-family: "Atkinson Hyperlegible", sans-serif;
                font-size: 1rem;
                line-height: 1.65;
            }

            a {
                color: var(--rust);
                font-weight: 700;
                text-underline-offset: 0.18em;
                text-decoration-thickness: 2px;
            }

            a:hover {
                color: #6c2718;
            }

            a:focus-visible,
            button:focus-visible {
                outline: 4px solid var(--blue);
                outline-offset: 4px;
            }

            .skip-link {
                position: fixed;
                z-index: 20;
                top: 0.75rem;
                left: 0.75rem;
                padding: 0.6rem 0.9rem;
                color: var(--paper);
                background: var(--ink);
                transform: translateY(-200%);
            }

            .skip-link:focus {
                transform: translateY(0);
            }

            .page-shell {
                width: min(100% - 2rem, 78rem);
                margin: 0 auto;
                overflow: hidden;
                border: var(--line);
                background: var(--paper);
                box-shadow: none;
            }

            .topbar {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 1rem;
                padding: 0.7rem 1rem;
                border-bottom: var(--line);
                background: var(--slime);
                font-size: 0.82rem;
                font-weight: 700;
                letter-spacing: 0.08em;
                line-height: 1.2;
                text-transform: uppercase;
            }

            .topbar a {
                color: var(--ink);
                text-decoration: none;
            }

            .edition {
                display: flex;
                align-items: center;
                gap: 0.5rem;
                white-space: nowrap;
            }

            .edition::before {
                width: 0.7rem;
                height: 0.7rem;
                border: 2px solid var(--ink);
                border-radius: 50%;
                background: var(--orange);
                content: "";
            }

            .hero {
                display: grid;
                border-bottom: var(--line);
                background: var(--paper-deep);
            }

            .hero-copy {
                position: relative;
                z-index: 1;
                display: flex;
                flex-direction: column;
                justify-content: center;
                padding: clamp(2rem, 7vw, 5.5rem) clamp(1.2rem, 5vw, 4rem);
                border-bottom: var(--line);
            }

            .eyebrow,
            .fact-label,
            .system-card small {
                margin: 0 0 0.55rem;
                font-size: 0.78rem;
                font-weight: 700;
                letter-spacing: 0.13em;
                line-height: 1.25;
                text-transform: uppercase;
            }

            .eyebrow span {
                display: inline-block;
                margin-left: 0.25rem;
                padding: 0.12rem 0.45rem;
                border: 2px solid var(--ink);
                background: var(--orange);
                transform: rotate(-2deg);
            }

            .hero h1,
            h2,
            h3 {
                font-family: "Bowlby One SC", display;
                font-weight: 400;
                line-height: 1;
            }

            .hero h1 {
                max-width: 8ch;
                margin: 0;
                font-size: clamp(2.6rem, 12vw, 7rem);
                letter-spacing: -0.055em;
                text-wrap: balance;
            }

            .hero h1 span {
                color: var(--rust);
                -webkit-text-stroke: 1px var(--ink);
                text-shadow: 3px 3px 0 var(--slime);
            }

            .hero-deck {
                max-width: 34rem;
                margin: 1.4rem 0 0;
                font-size: clamp(1.1rem, 2vw, 1.35rem);
                font-weight: 700;
                line-height: 1.35;
            }

            .hero-tags {
                display: flex;
                flex-wrap: wrap;
                gap: 0.5rem;
                margin-top: 1.5rem;
            }

            .hero-tags span {
                padding: 0.3rem 0.65rem;
                border: 2px solid var(--ink);
                border-radius: 999px;
                background: var(--paper);
                font-size: 0.78rem;
                font-weight: 700;
                letter-spacing: 0.05em;
                line-height: 1.2;
                text-transform: uppercase;
            }

            .hero-art {
                position: relative;
                min-height: 22rem;
                margin: 0;
                overflow: hidden;
                background: #ddc784;
            }

            .hero-art img {
                position: absolute;
                width: 100%;
                height: 100%;
                object-fit: cover;
                object-position: 63% center;
            }

            .section-nav {
                position: sticky;
                z-index: 10;
                top: 0;
                border-bottom: var(--line);
                background: var(--ink);
            }

            .section-nav ul {
                display: flex;
                flex-wrap: wrap;
                justify-content: center;
                max-width: 68rem;
                margin: 0 auto;
                padding: 0.75rem 1rem;
                gap: 0.7rem 1.5rem;
                list-style: none;
            }

            .section-nav a {
                color: var(--paper);
                font-size: 0.85rem;
                letter-spacing: 0.06em;
                text-decoration: none;
                text-transform: uppercase;
                white-space: nowrap;
            }

            .section-nav a:hover {
                color: var(--slime);
            }

            main {
                display: block;
            }

            main section {
                padding: clamp(3rem, 7vw, 6rem) clamp(1.2rem, 6vw, 5rem);
                border-bottom: var(--line);
            }

            main section:last-child {
                border-bottom: 0;
            }

            main section > * {
                max-width: 68rem;
                margin-right: auto;
                margin-left: auto;
            }

            h2 {
                margin-top: 0;
                margin-bottom: 1.5rem;
                font-size: clamp(2.3rem, 6vw, 4rem);
                letter-spacing: -0.035em;
            }

            h3 {
                margin-top: 0;
                font-size: 1.35rem;
                letter-spacing: -0.015em;
            }

            p,
            li {
                font-size: clamp(1rem, 1.5vw, 1.13rem);
            }

            .lede {
                max-width: 46rem;
                margin-left: 0;
                font-size: clamp(1.25rem, 2.6vw, 1.75rem);
                font-weight: 700;
                line-height: 1.35;
            }

            .intro-grid,
            .prep-grid {
                display: grid;
                gap: 2rem;
            }

            .donation-card,
            .system-card {
                padding: 1.35rem;
                border: var(--line);
                background: var(--slime);
                box-shadow: 6px 6px 0 var(--ink);
                transform: rotate(0.5deg);
            }

            .donation-card p,
            .system-card p {
                margin-top: 0;
            }

            .button-link {
                display: inline-block;
                padding: 0.65rem 0.9rem;
                border: 2px solid var(--ink);
                color: var(--paper);
                background: var(--ink);
                box-shadow: 3px 3px 0 var(--orange);
                line-height: 1.2;
                text-decoration: none;
            }

            .button-link:hover {
                color: var(--ink);
                background: var(--orange);
                box-shadow: 3px 3px 0 var(--ink);
            }

            .facts {
                display: grid;
                margin-top: 3rem;
                padding: 0;
                border-top: var(--line);
                border-left: var(--line);
                list-style: none;
            }

            .facts li {
                min-width: 0;
                padding: 1rem;
                border-right: var(--line);
                border-bottom: var(--line);
                background: var(--paper-deep);
            }

            .fact-label {
                display: block;
                margin-bottom: 0.25rem;
                color: var(--slime-dark);
            }

            .story {
                background: var(--orange);
            }

            .story-copy {
                max-width: 48rem;
                margin-left: auto;
                padding: clamp(1.2rem, 4vw, 2.6rem);
                border: var(--line);
                background: var(--paper);
                box-shadow: 8px 8px 0 var(--ink);
                transform: rotate(-0.25deg);
            }

            .story-copy p:first-child::first-letter {
                float: left;
                margin: 0.05em 0.08em 0 0;
                color: var(--rust);
                font-family: "Bowlby One SC", display;
                font-size: 4.2rem;
                line-height: 0.8;
            }

            .pullquote {
                max-width: 46rem;
                margin-top: 3rem;
                margin-bottom: 0;
                padding: 0;
                border: 0;
                font-family: "Bowlby One SC", display;
                font-size: clamp(1.8rem, 4vw, 3.4rem);
                line-height: 1.08;
                text-align: center;
                transform: rotate(1deg);
            }

            .pullquote::before,
            .pullquote::after {
                color: var(--paper);
                content: "✦";
            }

            .prep {
                background: var(--paper);
            }

            .system-card {
                align-self: start;
                background: var(--blue);
                color: var(--paper);
                transform: rotate(-1deg);
            }

            .system-name {
                display: block;
                margin-bottom: 0.6rem;
                color: var(--paper);
                font-family: "Bowlby One SC", display;
                font-size: clamp(2rem, 5vw, 3rem);
                line-height: 1;
            }

            .checklist {
                padding-left: 0;
                list-style: none;
            }

            .checklist li {
                position: relative;
                margin: 0.8rem 0;
                padding-left: 1.8rem;
            }

            .checklist li::before {
                position: absolute;
                top: -0.08rem;
                left: 0;
                color: var(--rust);
                content: "✦";
                font-size: 1.15rem;
            }

            .dates {
                background: var(--paper-deep);
            }

            .page-footer {
                display: flex;
                flex-wrap: wrap;
                justify-content: space-between;
                gap: 0.5rem 1.5rem;
                padding: 1rem;
                border-top: var(--line);
                color: var(--paper);
                background: var(--ink);
                font-size: 0.78rem;
                font-weight: 700;
                letter-spacing: 0.06em;
                text-transform: uppercase;
            }

            .page-footer a {
                color: var(--slime);
            }

            @media (min-width: 36rem) {
                body {
                    padding: 2rem 0;
                }

                .page-shell {
                    width: min(100% - 4rem, 78rem);
                }

                .facts {
                    grid-template-columns: repeat(2, 1fr);
                }
            }

            @media (min-width: 52rem) {
                .page-shell {
                    box-shadow: 9px 10px 0 rgba(23, 25, 18, 0.9);
                }

                .hero {
                    grid-template-columns: minmax(23rem, 0.9fr) minmax(
                            0,
                            1.35fr
                        );
                    min-height: 36rem;
                }

                .hero-copy {
                    border-right: var(--line);
                    border-bottom: 0;
                }

                .hero-art {
                    min-height: 36rem;
                }

                .hero-art img {
                    object-position: 60% center;
                }

                .intro-grid {
                    grid-template-columns: minmax(0, 1.5fr) minmax(
                            17rem,
                            0.7fr
                        );
                    align-items: start;
                }

                .prep-grid {
                    grid-template-columns: minmax(0, 1.3fr) minmax(
                            17rem,
                            0.7fr
                        );
                }

                .facts {
                    grid-template-columns: repeat(4, 1fr);
                }
            }

            @media (prefers-reduced-motion: reduce) {
                html {
                    scroll-behavior: auto;
                }
            }
        </style>
    </head>
    <body>
        <a class="skip-link" href="#main-content">
            Skip to the adventure
        </a>
        <div class="page-shell">
            <div class="topbar">
                <a href="/">← Movember one-shots</a>
                <span class="edition">2026 edition</span>
            </div>
            <header class="hero">
                <div class="hero-copy">
                    <p class="eyebrow">A charity tabletop adventure</p>
                    <h1>
                        Enterprising <span>Warlocks</span>
                    </h1>
                    <p class="hero-deck">
                        Edenvale needs your help. The skeletons are already on
                        their way down.
                    </p>
                    <div class="hero-tags" aria-label="Event summary">
                        <span>Keeper's Call</span>
                        <span>Online</span>
                        <span>Schedule via Chronos</span>
                    </div>
                </div>
                <figure class="hero-art">
                    <img
                        src="/img/enterprising-warlocks-hero.avif"
                        alt="A ramshackle airship full of skeletons hovers between the cheerful town of Edenvale and the foul Slime Lands."
                        width="1536"
                        height="1024"
                        fetchpriority="high"
                    />
                </figure>
            </header>
            <main id="main-content">
                <slot />
            </main>
            <footer class="page-footer">
                <span>Rolled up for men's health in Bermuda</span>
                <a href="/">Past adventures</a>
            </footer>
        </div>
    </body>
</html>
